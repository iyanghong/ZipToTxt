ARG BASE_IMAGE=ubuntu:22.04
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update
RUN apt-get install -y --no-install-recommends python3 python3-venv python3-tk binutils xvfb xauth
RUN apt-get install -y --no-install-recommends libpython3.10
RUN python3 -m venv /opt/venv
RUN /opt/venv/bin/python -m pip install --no-cache-dir cryptography pyinstaller

WORKDIR /src
COPY zip_to_txt.py zip_to_txt_gui.py git_archive.py ./
RUN /opt/venv/bin/python -m PyInstaller --onefile --name zip-to-txt-gui zip_to_txt_gui.py
